#!/usr/bin/env python3
"""Print the Hermes CLI Cockpit native-cmux/remote-tmux workspace plan.

This command is intentionally read-only. It does not open cmux, attach tmux,
start gateways, install launchd services, or post to external systems.
"""
from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:  # pragma: no cover - current macOS env has py3.11+
    tomllib = None

ROOT = Path(__file__).resolve().parents[1]
DEFAULT_CONFIG = ROOT / "config" / "cockpit-workspaces.toml"


def _simple_toml_value(raw: str) -> object:
    """Parse the small TOML subset used by cockpit-workspaces.toml.

    This fallback exists for iMac system Python builds older than 3.11, where
    stdlib tomllib is unavailable. It intentionally supports only the registry
    shape we own here: quoted strings, integers, and arrays of quoted strings.
    """
    raw = raw.strip()
    if raw.startswith('"') and raw.endswith('"'):
        return raw[1:-1]
    if raw.startswith("[") and raw.endswith("]"):
        inner = raw[1:-1].strip()
        if not inner:
            return []
        return [_simple_toml_value(part.strip()) for part in inner.split(",")]
    try:
        return int(raw)
    except ValueError:
        return raw


def _simple_toml_loads(text: str) -> dict:
    """Minimal parser for this repo's owned cockpit workspace registry."""
    cfg: dict = {}
    current: dict | None = None

    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if stripped == "[[workspace]]":
            current = {}
            cfg.setdefault("workspace", []).append(current)
            continue
        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped[1:-1]
            current = cfg.setdefault(section, {})
            continue
        if "=" not in stripped or current is None:
            continue
        key, value = stripped.split("=", 1)
        current[key.strip()] = _simple_toml_value(value)
    return cfg


def load_config(path: Path) -> dict:
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        raise SystemExit(f"cockpit-workspaces: config not found: {path}")
    if tomllib is not None:
        return tomllib.loads(text)
    return _simple_toml_loads(text)


def workspaces(cfg: dict) -> list[dict]:
    return sorted(cfg.get("workspace", []), key=lambda w: int(w.get("number", 999)))


def find_workspace(cfg: dict, ident: str) -> dict:
    ident = ident.lower()
    for ws in workspaces(cfg):
        if ident in {str(ws.get("id", "")).lower(), str(ws.get("number", "")), str(ws.get("title", "")).lower()}:
            return ws
    known = ", ".join(f"{w.get('number')}:{w.get('id')}" for w in workspaces(cfg))
    raise SystemExit(f"unknown workspace {ident!r}; known: {known}")


def run_readonly(cmd: list[str]) -> tuple[int, str]:
    try:
        proc = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=5)
    except FileNotFoundError:
        return 127, f"missing command: {cmd[0]}"
    except subprocess.TimeoutExpired:
        return 124, f"timeout: {' '.join(cmd)}"
    return proc.returncode, proc.stdout.strip()


def parse_worktrees(output: str) -> list[dict]:
    items = []
    current = {}
    for line in output.splitlines():
        if not line:
            if current:
                items.append(current)
                current = {}
            continue
        if " " in line:
            key, value = line.split(" ", 1)
        else:
            key, value = line, ""
        current[key] = value
    if current:
        items.append(current)
    return items


def git_dirty_count(path: str) -> str:
    code, out = run_readonly(["git", "-C", path, "status", "--short"])
    if code != 0:
        return "unknown"
    if not out:
        return "clean"
    return f"{len(out.splitlines())} changes"


def cmux_available() -> str:
    path = shutil.which("cmux")
    if not path:
        return "missing"
    # The repo helper historically shadows official cmux. Flag that clearly.
    try:
        resolved = str(Path(path).resolve())
    except OSError:
        resolved = path
    if resolved == str((ROOT / "bin" / "cmux").resolve()):
        return f"shadowed-by-repo-helper ({path})"
    return path


def print_header(cfg: dict) -> None:
    topo = cfg.get("topology", {})
    print("Hermes CLI Cockpit workspace plan")
    print("=" * 42)
    print(f"local visual client : {topo.get('local_visual_client')}")
    print(f"remote runtime      : {topo.get('remote_runtime')}")
    print(f"remote alias        : {topo.get('remote_alias')}")
    print(f"vault               : {topo.get('vault_path')}")
    print(f"repo                : {topo.get('repo_path')}")
    print(f"cmux on PATH        : {cmux_available()}")
    print(f"rule                : {topo.get('rule')}")
    print()


def cmd_list(args: argparse.Namespace, cfg: dict) -> int:
    print_header(cfg)
    print("Workspaces")
    for ws in workspaces(cfg):
        print(f"  {ws.get('number')}. {ws.get('title'):<15} id={ws.get('id'):<10} tmux={ws.get('remote_tmux_session')} plane={ws.get('plane')}")
    print()
    print("Use: cockpit-workspaces show <id|number>  or  cockpit-workspaces commands <id|number>")
    return 0


def cmd_show(args: argparse.Namespace, cfg: dict) -> int:
    ws = find_workspace(cfg, args.workspace)
    print_header(cfg)
    print(f"Workspace {ws.get('number')}: {ws.get('title')} ({ws.get('id')})")
    print("-" * 42)
    for key in [
        "plane",
        "local_surface",
        "remote_tmux_session",
        "attach_command",
        "cmux_remote_command",
        "primary_browser_target",
        "secondary_browser_target",
        "notes",
    ]:
        if key in ws:
            print(f"{key:24} {ws[key]}")
    return 0


def cmd_commands(args: argparse.Namespace, cfg: dict) -> int:
    ws = find_workspace(cfg, args.workspace)
    topo = cfg.get("topology", {})
    remote = os.environ.get("AI_REMOTE", topo.get("remote_alias", "ai-remote"))
    print(f"# {ws.get('title')} command card")
    print("# Read-only unless you explicitly run one of these yourself.")
    print()
    print("# Local iMac native cmux workspace shell")
    print(f"cmux ssh {remote}")
    print()
    print("# Remote MBP tmux attach inside that cmux SSH workspace")
    print(ws.get("attach_command"))
    print()
    print("# Browser targets to keep beside the workspace")
    for target in [ws.get("primary_browser_target"), ws.get("secondary_browser_target")]:
        if target:
            print(f"#   {target}")
    if ws.get("id") == "openclaw":
        print()
        print("# OpenClaw normal gateway path")
        print(ws.get("normal_gateway_status"))
        print(ws.get("normal_gateway_run"))
        print("# To make it service-owned, use only after deliberate operator approval:")
        print(ws.get("normal_gateway_start"))
        print()
        print("# Debug/lab fallback, not the only OpenClaw path")
        print(ws.get("lab_gateway_run"))
    if ws.get("id") == "agent-deck":
        policy = cfg.get("worktree_policy", {})
        repo = str(topo.get("repo_path", ROOT))
        root = str(policy.get("default_root", "/Users/openclaw/Code/worktrees"))
        prefix = str(policy.get("branch_prefix", "agent/"))
        template = str(policy.get("worktree_name_template", "{repo}-{slug}"))
        repo_name = Path(repo).name
        worktree_prefix = template.replace("{repo}", repo_name).replace("{slug}", "")
        print()
        print("# Worktree policy")
        for key in sorted(policy):
            print(f"#   {key}: {policy[key]}")
        print()
        print("# Read-only live inventory")
        print("cockpit-workspaces inventory agent-deck")
        print(f"git -C {sh_quote(repo)} worktree list --porcelain")
        print("tmux -L agent-deck list-sessions -F '#{session_name} windows=#{session_windows} attached=#{session_attached}'")
        print()
        print("# Create one isolated agent worktree; edit slug before running")
        print("slug=short-task-name")
        print(f"branch={sh_quote(prefix)}\"$slug\"")
        print(f"worktree={sh_quote(str(Path(root) / worktree_prefix))}\"$slug\"")
        print(f"mkdir -p {sh_quote(root)}")
        print(f'git -C {sh_quote(repo)} worktree add -b "$branch" "$worktree" main')
        print('cd "$worktree"')
        print()
        print("# Launch exactly one agent in that worktree")
        print("codex        # or: claude / opencode / hermes --worktree")
        print()
        print("# Review before merge")
        print("git status --short --branch")
        print("git diff --stat")
        print("git diff --check")
        print("git diff")
        print()
        print("# Optional agent-deck wrapper if already installed")
        print("agent-deck")
    return 0


def cmd_inventory(args: argparse.Namespace, cfg: dict) -> int:
    ws = find_workspace(cfg, args.workspace)
    topo = cfg.get("topology", {})
    policy = cfg.get("worktree_policy", {})
    repo = str(topo.get("repo_path", ROOT))
    root = str(policy.get("default_root", "/Users/openclaw/Code/worktrees"))
    prefix = str(policy.get("branch_prefix", "agent/"))
    max_slots = int(policy.get("max_slots", 4))
    labels = list(policy.get("slot_labels", ["A", "B", "C", "D"]))

    print(f"# {ws.get('title')} live inventory")
    print("# Read-only: no sessions are created, no agents are launched, no worktrees are added.")
    print()
    print("Policy")
    print(f"  repo:          {repo}")
    print(f"  worktree root: {root}")
    print(f"  branch prefix: {prefix}")
    print(f"  rule:          {policy.get('rule_1', 'one agent, one branch, one worktree')}")
    print()

    print("Agent-deck")
    ad = shutil.which("agent-deck")
    print(f"  binary:        {ad or 'missing'}")
    code, out = run_readonly(["tmux", "-L", "agent-deck", "list-sessions", "-F", "#{session_name} windows=#{session_windows} attached=#{session_attached}"])
    if code == 0 and out:
        for line in out.splitlines():
            print(f"  tmux:          {line}")
    else:
        print("  tmux:          no agent-deck socket/session visible")
    print()

    print("Git worktrees")
    code, out = run_readonly(["git", "-C", repo, "worktree", "list", "--porcelain"])
    if code != 0:
        print(f"  error:         {out}")
        return 0

    trees = parse_worktrees(out)
    if not trees:
        print("  none")
    for tree in trees:
        path = tree.get("worktree", "")
        branch = tree.get("branch", "detached").replace("refs/heads/", "")
        head = tree.get("HEAD", "")[:12]
        dirty = git_dirty_count(path) if path else "unknown"
        marker = "agent" if branch.startswith(prefix) else "base"
        print(f"  {marker:<5} {branch:<32} {dirty:<12} {head} {path}")
    print()

    agent_trees = [t for t in trees if t.get("branch", "").replace("refs/heads/", "").startswith(prefix)]
    print("Agent slots")
    for index in range(max_slots):
        label = labels[index] if index < len(labels) else str(index + 1)
        if index < len(agent_trees):
            tree = agent_trees[index]
            path = tree.get("worktree", "")
            branch = tree.get("branch", "").replace("refs/heads/", "")
            print(f"  {label}: filled  branch={branch} path={path} status={git_dirty_count(path)}")
        else:
            print(f"  {label}: empty   create with branch {prefix}<slug> under {root}")
    return 0


def cmd_env(args: argparse.Namespace, cfg: dict) -> int:
    ws = find_workspace(cfg, args.workspace)
    topo = cfg.get("topology", {})
    print(f"export COCKPIT_WORKSPACE_ID={sh_quote(str(ws.get('id')))}")
    print(f"export COCKPIT_WORKSPACE_TITLE={sh_quote(str(ws.get('title')))}")
    print(f"export COCKPIT_REMOTE_ALIAS={sh_quote(str(topo.get('remote_alias', 'ai-remote')))}")
    print(f"export COCKPIT_REMOTE_TMUX_SESSION={sh_quote(str(ws.get('remote_tmux_session')))}")
    print(f"export COCKPIT_VAULT_PATH={sh_quote(str(topo.get('vault_path', '')))}")
    print(f"export COCKPIT_REPO_PATH={sh_quote(str(topo.get('repo_path', '')))}")
    return 0


def sh_quote(value: str) -> str:
    return "'" + value.replace("'", "'\\''") + "'"


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Read-only Hermes CLI Cockpit workspace cards")
    parser.add_argument("--config", default=str(DEFAULT_CONFIG), help="workspace TOML config")
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("list", help="list the four cmux/tmux workspaces")

    show = sub.add_parser("show", help="show one workspace card")
    show.add_argument("workspace", help="workspace id, title, or number")

    commands = sub.add_parser("commands", help="print operator commands for one workspace")
    commands.add_argument("workspace", help="workspace id, title, or number")

    inventory = sub.add_parser("inventory", help="print read-only live inventory for one workspace")
    inventory.add_argument("workspace", help="workspace id, title, or number")

    env = sub.add_parser("env", help="print shell exports for one workspace")
    env.add_argument("workspace", help="workspace id, title, or number")
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    cfg = load_config(Path(args.config).expanduser())
    command = args.command or "list"
    if command == "list":
        return cmd_list(args, cfg)
    if command == "show":
        return cmd_show(args, cfg)
    if command == "commands":
        return cmd_commands(args, cfg)
    if command == "inventory":
        return cmd_inventory(args, cfg)
    if command == "env":
        return cmd_env(args, cfg)
    parser.error(f"unknown command: {command}")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
