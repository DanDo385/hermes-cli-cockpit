#!/usr/bin/env bash
set -euo pipefail

HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
LOG_DIR="$HERMES_HOME/logs"
GATEWAY_ERROR_LOG="$LOG_DIR/gateway.error.log"

HEALTH_BAD=0
HEALTH_WARN=0
NEXT_ACTION="Monitor. Gateway and cron are healthy."

status_ok() { printf '%-18s %s\n' "$1:" "✅ $2"; }
status_warn() { HEALTH_WARN=$((HEALTH_WARN + 1)); [[ "$NEXT_ACTION" == Monitor.* ]] && NEXT_ACTION="Review warning: $1 - $2"; printf '%-18s %s\n' "$1:" "⚠️  $2"; }
status_bad() { HEALTH_BAD=$((HEALTH_BAD + 1)); NEXT_ACTION="Act now: $1 - $2"; printf '%-18s %s\n' "$1:" "❌ $2"; }
status_info() { printf '%-18s %s\n' "$1:" "ℹ️  $2"; }

count_ports() {
  lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | tail -n +2 | wc -l | tr -d ' '
}

check_gateway() {
  if ! command -v hermes >/dev/null 2>&1; then
    status_bad gateway "hermes command missing"
    return
  fi

  local out
  out="$(hermes gateway status 2>&1 || true)"
  if printf '%s\n' "$out" | grep -qi 'Gateway service is loaded'; then
    if printf '%s\n' "$out" | grep -q '"PID"'; then
      local pid
      pid="$(printf '%s\n' "$out" | sed -n 's/.*"PID" = \([0-9][0-9]*\).*/\1/p' | head -1)"
      status_ok gateway "running${pid:+, pid $pid}"
    else
      status_ok gateway "loaded"
    fi
  elif printf '%s\n' "$out" | grep -qi 'Gateway service is not loaded'; then
    if [[ -f "$GATEWAY_ERROR_LOG" ]] && tail -n 500 "$GATEWAY_ERROR_LOG" 2>/dev/null | grep -Eq 'discord connect timed out|503 Service Unavailable|no healthy upstream|HTTP 429|rate.?limit'; then
      status_bad gateway "launchd not loaded; recent Discord connect/rate-limit failure, left stopped to avoid retry loop"
    else
      status_bad gateway "launchd service not loaded; run: hermes gateway start"
    fi
  else
    status_bad gateway "status unclear; run: hermes gateway status"
  fi
}

check_cron() {
  if ! command -v hermes >/dev/null 2>&1; then
    status_bad cron "hermes command missing"
    return
  fi

  local out
  out="$(hermes cron status 2>&1 || true)"
  if printf '%s\n' "$out" | grep -qi 'Gateway is not running\|will NOT fire'; then
    status_bad cron "gateway down; automatic jobs will NOT fire"
  elif printf '%s\n' "$out" | grep -qi 'running'; then
    status_ok cron "running"
  elif printf '%s\n' "$out" | grep -qi 'active'; then
    status_ok cron "active"
  else
    status_warn cron "status unclear"
  fi
}

check_cron_models() {
  local jobs_json="$HERMES_HOME/cron/jobs.json"
  if [[ ! -f "$jobs_json" ]]; then
    status_warn "cron models" "jobs.json not found"
    return
  fi

  local out
  out="$(python3 - "$jobs_json" <<'PY' 2>/dev/null || true
import json, sys
from pathlib import Path
path = Path(sys.argv[1])
data = json.loads(path.read_text())
active = [j for j in data.get('jobs', []) if j.get('enabled', True)]
gemini = []
pinned = []
inherited = 0
for job in active:
    provider = job.get('provider')
    model = job.get('model')
    name = job.get('name') or job.get('id') or '<unnamed>'
    route = ' '.join(str(x) for x in (provider, model) if x)
    if not provider and not model:
        inherited += 1
    else:
        pinned.append((provider or '<default-provider>', model or '<default-model>'))
    if 'gemini' in route.lower():
        gemini.append(name)
if gemini:
    print('bad|' + ', '.join(gemini[:4]))
else:
    routes = sorted(set(f'{p}/{m}' for p, m in pinned))
    summary = ', '.join(routes[:3]) if routes else 'all inherit default'
    suffix = f'; {inherited} inherit default' if inherited else ''
    print('ok|' + summary + suffix)
PY
)"

  case "$out" in
    bad\|*) status_bad "cron models" "active Gemini cron override(s): ${out#bad|}" ;;
    ok\|*) status_ok "cron models" "${out#ok|}; no active Gemini cron overrides" ;;
    *) status_warn "cron models" "unable to inspect cron model routes" ;;
  esac
}

check_gemini_history() {
  if [[ -f "$GATEWAY_ERROR_LOG" ]] && tail -n 300 "$GATEWAY_ERROR_LOG" 2>/dev/null | grep -Eq 'Gemini HTTP 429|RESOURCE_EXHAUSTED|Quota exceeded'; then
    status_warn gemini "historical Gemini quota errors remain in logs"
  else
    status_ok gemini "no recent quota errors found"
  fi
}

check_onepassword() {
  if ! command -v op >/dev/null 2>&1; then
    status_bad "1password cli" "op command missing"
    return
  fi

  local out
  out="$(op whoami 2>&1 || true)"
  if printf '%s\n' "$out" | grep -qi 'User Type'; then
    local user_type
    user_type="$(printf '%s\n' "$out" | sed -n 's/^User Type:[[:space:]]*//p' | head -1)"
    status_ok "1password cli" "connected${user_type:+ as $user_type}"
  else
    status_bad "1password cli" "not authenticated"
  fi
}

check_ssh_agent() {
  if [[ -z "${SSH_AUTH_SOCK:-}" ]]; then
    status_bad "ssh agent" "SSH_AUTH_SOCK unset"
    return
  fi

  local out
  out="$(ssh-add -l 2>&1 || true)"
  if printf '%s\n' "$out" | grep -qi 'no identities'; then
    status_warn "ssh agent" "connected, no identities loaded"
  elif printf '%s\n' "$out" | grep -Eq 'SHA256|ssh-ed25519|RSA|ED25519'; then
    local count
    count="$(printf '%s\n' "$out" | wc -l | tr -d ' ')"
    status_ok "ssh agent" "$count identity/identities available"
  else
    status_warn "ssh agent" "status unclear: $out"
  fi
}

check_ports() {
  local n
  n="$(count_ports)"
  status_info ports "$n listening TCP socket(s)"
}

main() {
  local tmp overall
  tmp="$(mktemp)"

  {
    check_gateway
    check_cron
    check_cron_models
    check_gemini_history
    check_onepassword
    check_ssh_agent
    check_ports
  } >"$tmp"

  if [[ "$HEALTH_BAD" -gt 0 ]]; then
    overall="DEGRADED"
  elif [[ "$HEALTH_WARN" -gt 0 ]]; then
    overall="WATCH"
  else
    overall="HEALTHY"
  fi

  printf 'Hermes CLI Cockpit Health\n'
  printf 'Host: %s\n' "$(hostname)"
  printf 'Time: %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')"
  printf 'Overall: %s\n' "$overall"
  printf 'Next: %s\n' "$NEXT_ACTION"
  printf '\n'
  cat "$tmp"
  rm -f "$tmp"

  printf '\nHints:\n'
  printf '  tmux windows: Ctrl-b w picker, Ctrl-b n/p next/prev, Ctrl-b z zoom\n'
  printf '  direct window jump: Ctrl-b <number shown in the bottom bar>\n'
  printf '  gateway triage: Ctrl-b 2, hermes gateway status, tail -n 120 ~/.hermes/logs/gateway.error.log\n'
  printf '  cron amendments: Ctrl-b 3, hermes cron edit|pause|resume|run <job_id>\n'
  printf '  stale sessions: Ctrl-b 4, inspect PIDs before kill -TERM <pid>\n'
  printf '  inspect ports: Ctrl-b 6, ports | port-who <port>\n'
}

main "$@"
