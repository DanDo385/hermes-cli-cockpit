#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'HELP'
port-who: show which process is listening on a TCP port

Usage:
  port-who <port>
  port-who --help

Examples:
  port-who 3000
  port-who 4173

Notes:
  Read-only. Does not kill processes.
HELP
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -ne 1 ]]; then
  usage >&2
  exit 2
fi

PORT="$1"
if ! [[ "$PORT" =~ ^[0-9]+$ ]] || (( PORT < 1 || PORT > 65535 )); then
  echo "port-who: invalid TCP port: $PORT" >&2
  exit 2
fi

if ! command -v lsof >/dev/null 2>&1; then
  echo "port-who: required command missing: lsof" >&2
  exit 1
fi

printf 'Host: %s\n' "$(hostname)"
printf 'Port: %s\n' "$PORT"
printf 'Time: %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')"
printf '\n'

if ! lsof -nP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null; then
  echo "No listening TCP process found on port $PORT."
fi
