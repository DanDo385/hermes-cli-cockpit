#!/usr/bin/env bash
set -euo pipefail

# Legacy entrypoint: mission-control was replaced by mission-hermes (10-window peer layout).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ "${MISSION_LEGACY_WARN:-1}" != "0" ]]; then
  echo "mission: deprecated — use mission-hermes (tmux session mission-hermes). forwarding args..." >&2
fi

exec "$SCRIPT_DIR/mission-hermes" "$@"
