#!/usr/bin/env bash
set -euo pipefail

SESSION="mission-control"
HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
REPO_DIR="/Users/openclaw/Code/hermes-cli-cockpit"
PANE="$REPO_DIR/bin/mission-pane"
NO_ATTACH=0
RESET=0

for arg in "${@:-}"; do
  case "$arg" in
    --no-attach) NO_ATTACH=1 ;;
    --reset|--rebuild) RESET=1 ;;
    -h|--help)
      cat <<'HELP'
mission: open the Hermes CLI Cockpit tmux dashboard

Usage:
  mission              create/attach mission-control
  mission --no-attach  create/verify without attaching
  mission --reset      rebuild the cockpit layout, then attach

Mental model:
  tmux windows are dashboard pages. Panes are labeled cards on each page.

Windows:
  chat      main Hermes conversation pane, plus compact health/map panes
  overview  full health summary + operator runbook
  gateway   gateway status, normal log, error log, command shell
  cron      cron scheduler status and job list
  sessions  recent Hermes conversations
  security  safe 1Password and SSH-agent readiness, no secret values
  ports     local listening services
  scratch   blank shells
HELP
      exit 0
      ;;
  esac
done

require() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "mission: required command missing: $1" >&2
    exit 1
  fi
}

pane_cmd() {
  printf 'MISSION_REPO_DIR=%q %q %q' "$REPO_DIR" "$PANE" "$1"
}

set_pane_title() {
  tmux select-pane -t "$1" -T "$2" >/dev/null 2>&1 || true
}

setup_tmux_options() {
  tmux set-option -t "$SESSION" status on >/dev/null
  tmux set-option -t "$SESSION" status-left '#[bold] Hermes Cockpit #[fg=cyan]#I:#W #[default]' >/dev/null
  tmux set-option -t "$SESSION" status-right '#[fg=green]C-b w picker #[fg=yellow]C-b z zoom #[fg=cyan]C-b d detach #[fg=white]#H %H:%M' >/dev/null
  tmux set-option -t "$SESSION" pane-border-status top >/dev/null
  tmux set-option -t "$SESSION" pane-border-format ' #{pane_title} ' >/dev/null
  tmux set-option -t "$SESSION" allow-set-title off >/dev/null
  tmux set-option -t "$SESSION" set-titles on >/dev/null
  tmux set-option -t "$SESSION" default-size 180x48 >/dev/null 2>&1 || true
  tmux set-window-option -t "$SESSION" automatic-rename off >/dev/null
  tmux set-window-option -t "$SESSION" aggressive-resize on >/dev/null 2>&1 || true
}

normalize_window_sizes() {
  local w
  for w in chat overview gateway cron sessions security ports scratch; do
    tmux resize-window -t "$SESSION:$w" -x 180 -y 48 >/dev/null 2>&1 || true
  done
}

build_session() {
  local p_chat p_chat_health p_chat_guide p_overview p_guide
  local p_gateway_status p_gateway_log p_gateway_errors p_gateway_shell
  local p_cron p_cron_shell p_sessions p_sessions_shell p_security p_security_shell
  local p_ports p_ports_shell p_scratch_a p_scratch_b p_scratch_c

  tmux new-session -d -s "$SESSION" -n chat "$(pane_cmd hermes-chat)"
  setup_tmux_options
  p_chat="$(tmux list-panes -t "$SESSION:chat" -F '#{pane_id}' | head -1)"
  set_pane_title "$p_chat" "Hermes chat - type here"
  p_chat_health="$(tmux split-window -h -t "$p_chat" -P -F '#{pane_id}' "$(pane_cmd overview)")"
  set_pane_title "$p_chat_health" "Health - live"
  p_chat_guide="$(tmux split-window -v -t "$p_chat_health" -P -F '#{pane_id}' "$(pane_cmd guide-compact)")"
  set_pane_title "$p_chat_guide" "Map - keys/pages"
  tmux select-layout -t "$SESSION:chat" main-vertical >/dev/null
  tmux resize-pane -t "$p_chat" -x 100 >/dev/null 2>&1 || true
  tmux select-pane -t "$p_chat" >/dev/null

  tmux new-window -t "$SESSION" -n overview "$(pane_cmd overview)"
  setup_tmux_options
  p_overview="$(tmux list-panes -t "$SESSION:overview" -F '#{pane_id}' | head -1)"
  set_pane_title "$p_overview" "Health summary"
  p_guide="$(tmux split-window -h -t "$p_overview" -P -F '#{pane_id}' "$(pane_cmd runbook)")"
  set_pane_title "$p_guide" "Operator runbook"
  tmux select-layout -t "$SESSION:overview" even-horizontal >/dev/null

  tmux new-window -t "$SESSION" -n gateway "$(pane_cmd gateway-status)"
  p_gateway_status="$(tmux list-panes -t "$SESSION:gateway" -F '#{pane_id}' | head -1)"
  set_pane_title "$p_gateway_status" "Gateway - status"
  p_gateway_log="$(tmux split-window -h -t "$p_gateway_status" -P -F '#{pane_id}' "$(pane_cmd gateway-log)")"
  set_pane_title "$p_gateway_log" "Gateway - log"
  p_gateway_errors="$(tmux split-window -v -t "$p_gateway_log" -P -F '#{pane_id}' "$(pane_cmd gateway-errors)")"
  set_pane_title "$p_gateway_errors" "Gateway - errors"
  p_gateway_shell="$(tmux split-window -v -t "$p_gateway_status" -P -F '#{pane_id}' "$(pane_cmd gateway-shell)")"
  set_pane_title "$p_gateway_shell" "Gateway - commands"
  tmux select-layout -t "$SESSION:gateway" tiled >/dev/null

  tmux new-window -t "$SESSION" -n cron "$(pane_cmd cron)"
  p_cron="$(tmux list-panes -t "$SESSION:cron" -F '#{pane_id}' | head -1)"
  set_pane_title "$p_cron" "Cron - jobs/routes"
  p_cron_shell="$(tmux split-window -h -t "$p_cron" -P -F '#{pane_id}' "$(pane_cmd cron-shell)")"
  set_pane_title "$p_cron_shell" "Cron - commands"
  tmux select-layout -t "$SESSION:cron" even-horizontal >/dev/null

  tmux new-window -t "$SESSION" -n sessions "$(pane_cmd sessions)"
  p_sessions="$(tmux list-panes -t "$SESSION:sessions" -F '#{pane_id}' | head -1)"
  set_pane_title "$p_sessions" "Sessions - cleanup"
  p_sessions_shell="$(tmux split-window -h -t "$p_sessions" -P -F '#{pane_id}' "$(pane_cmd sessions-shell)")"
  set_pane_title "$p_sessions_shell" "Sessions - commands"
  tmux select-layout -t "$SESSION:sessions" even-horizontal >/dev/null

  tmux new-window -t "$SESSION" -n security "$(pane_cmd security)"
  p_security="$(tmux list-panes -t "$SESSION:security" -F '#{pane_id}' | head -1)"
  set_pane_title "$p_security" "Security - readiness"
  p_security_shell="$(tmux split-window -h -t "$p_security" -P -F '#{pane_id}' "$(pane_cmd security-shell)")"
  set_pane_title "$p_security_shell" "Security - commands"
  tmux select-layout -t "$SESSION:security" even-horizontal >/dev/null

  tmux new-window -t "$SESSION" -n ports "$(pane_cmd ports)"
  p_ports="$(tmux list-panes -t "$SESSION:ports" -F '#{pane_id}' | head -1)"
  set_pane_title "$p_ports" "Ports - ownership"
  p_ports_shell="$(tmux split-window -h -t "$p_ports" -P -F '#{pane_id}' "$(pane_cmd ports-shell)")"
  set_pane_title "$p_ports_shell" "Ports - commands"
  tmux select-layout -t "$SESSION:ports" even-horizontal >/dev/null

  tmux new-window -t "$SESSION" -n scratch "$(pane_cmd scratch)"
  p_scratch_a="$(tmux list-panes -t "$SESSION:scratch" -F '#{pane_id}' | head -1)"
  set_pane_title "$p_scratch_a" "Scratch shell A"
  p_scratch_b="$(tmux split-window -h -t "$p_scratch_a" -P -F '#{pane_id}' "$(pane_cmd scratch)")"
  set_pane_title "$p_scratch_b" "Scratch shell B"
  p_scratch_c="$(tmux split-window -v -t "$p_scratch_b" -P -F '#{pane_id}' "$(pane_cmd scratch)")"
  set_pane_title "$p_scratch_c" "Scratch shell C"
  tmux select-layout -t "$SESSION:scratch" tiled >/dev/null

  normalize_window_sizes

  tmux select-window -t "$SESSION:chat"
}

require tmux
require zsh
require hermes
mkdir -p "$HERMES_HOME/logs"
chmod +x "$PANE" >/dev/null 2>&1 || true
require "$PANE"

if [[ -n "${SSH_AUTH_SOCK:-}" ]] && tmux has-session -t "$SESSION" 2>/dev/null; then
  tmux set-environment -t "$SESSION" SSH_AUTH_SOCK "$SSH_AUTH_SOCK"
fi

if [[ "$RESET" -eq 1 ]] && tmux has-session -t "$SESSION" 2>/dev/null; then
  tmux kill-session -t "$SESSION"
fi

if ! tmux has-session -t "$SESSION" 2>/dev/null; then
  build_session
else
  setup_tmux_options
  normalize_window_sizes
  tmux select-window -t "$SESSION:chat" 2>/dev/null || true
fi

if [[ "$NO_ATTACH" -eq 1 ]]; then
  echo "mission: session ready: $SESSION"
  tmux list-windows -t "$SESSION" -F '#{window_index}: #{window_name} panes=#{window_panes}'
  echo "Attach: tmux attach -d -t $SESSION"
  echo "Navigate: Ctrl-b w picker, Ctrl-b z zoom, Ctrl-b d detach, Ctrl-b 0 chat"
else
  exec tmux attach -d -t "$SESSION"
fi
