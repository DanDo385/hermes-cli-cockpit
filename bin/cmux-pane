#!/usr/bin/env bash
set -euo pipefail

ROLE="${1:-hub}"
PAGE="${2:-${ROLE}}"
SESSION="${CMUX_SESSION:-cmux}"
TITLE="${CMUX_TITLE:-CMUX Agent Workbench}"
REPO_DIR="${CMUX_REPO_DIR:-/Users/openclaw/Code/hermes-cli-cockpit}"
COCKPIT_ROOT="${CMUX_COCKPIT_ROOT:-/Users/openclaw/Code/hermes-cli-cockpit}"
COCKPIT_BIN_DIR="${CMUX_COCKPIT_BIN_DIR:-$COCKPIT_ROOT/bin}"
export PATH="$COCKPIT_BIN_DIR:$PATH"
VAULT="${OBSIDIAN_VAULT_PATH:-$HOME/.hermes/workspace}"
NVIM_APPNAME_VALUE="${CMUX_NVIM_APPNAME:-nvim}"
BROWSER_URL="${CMUX_BROWSER_URL:-http://127.0.0.1:4173/}"
GITHUB_REPO="${CMUX_GITHUB_REPO:-DanDo385/hermes-cli-cockpit}"
TOPOLOGY="${CMUX_TOPOLOGY:-integrated}"
CONTEXT_PATH="${CMUX_CONTEXT_PATH:-$REPO_DIR}"
CONTEXT_KIND="${CMUX_CONTEXT_KIND:-project}"
CONTEXT_NAME="${CMUX_CONTEXT_NAME:-$(basename "$CONTEXT_PATH")}"
STATE_FILE="${CMUX_CONTEXT_STATE_FILE:-${XDG_CACHE_HOME:-$HOME/.cache}/hermes-cli-cockpit/cctx.env}"
GUIDE_MODE="${CMUX_GUIDE_MODE:-full}"

load_cctx_state() {
  [[ -r "$STATE_FILE" ]] || return 0

  local key value
  while IFS=$'\t' read -r key value; do
    case "$key" in
      CMUX_CONTEXT_PATH|CMUX_CONTEXT_KIND|CMUX_CONTEXT_NAME|CMUX_REPO_DIR|CMUX_BROWSER_URL|CMUX_MISSION_HINT|OBSIDIAN_VAULT_PATH)
        printf -v "$key" '%s' "$value"
        ;;
    esac
  done < <(python3 - "$STATE_FILE" <<'PY'
import shlex
import sys

allowed = {
    "CMUX_CONTEXT_PATH",
    "CMUX_CONTEXT_KIND",
    "CMUX_CONTEXT_NAME",
    "CMUX_REPO_DIR",
    "CMUX_BROWSER_URL",
    "CMUX_MISSION_HINT",
    "OBSIDIAN_VAULT_PATH",
}

path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as fh:
        for raw in fh:
            raw = raw.strip()
            if not raw or raw.startswith("#"):
                continue
            try:
                parts = shlex.split(raw, posix=True)
            except ValueError:
                continue
            if len(parts) != 2 or parts[0] != "export" or "=" not in parts[1]:
                continue
            key, value = parts[1].split("=", 1)
            if key in allowed:
                print(f"{key}\t{value}")
except OSError:
    pass
PY
  )
}

refresh_context_state() {
  [[ "${CMUX_DYNAMIC_CONTEXT:-1}" == "1" ]] || return 0
  [[ -r "$STATE_FILE" ]] || return 0
  load_cctx_state
  REPO_DIR="${CMUX_REPO_DIR:-$REPO_DIR}"
  VAULT="${OBSIDIAN_VAULT_PATH:-$VAULT}"
  BROWSER_URL="${CMUX_BROWSER_URL:-$BROWSER_URL}"
  CONTEXT_PATH="${CMUX_CONTEXT_PATH:-$CONTEXT_PATH}"
  CONTEXT_KIND="${CMUX_CONTEXT_KIND:-$CONTEXT_KIND}"
  CONTEXT_NAME="${CMUX_CONTEXT_NAME:-$(basename "$CONTEXT_PATH")}"
}

hr() { printf '%*s\n' "${COLUMNS:-100}" '' | tr ' ' '-'; }
now() { date '+%Y-%m-%d %H:%M:%S %Z'; }

header() {
  refresh_context_state
  clear || true
  printf '%s :: %s\n' "$TITLE" "$1"
  printf 'Session: %s   Repo: %s   Topology: %s   Time: %s\n' "$SESSION" "$REPO_DIR" "$TOPOLOGY" "$(now)"
  printf 'Cockpit: %s\n' "$COCKPIT_ROOT"
  printf 'Context: %s   Kind: %s   Name: %s\n' "$CONTEXT_PATH" "$CONTEXT_KIND" "$CONTEXT_NAME"
  hr
  printf '\n'
}

loop() {
  local title="$1" delay="$2"
  shift 2
  while true; do
    header "$title"
    "$@" 2>&1 || true
    printf '\n'
    hr
    printf 'Refresh: every %ss   Ctrl-c stops this pane command   Ctrl-b z zoom   Ctrl-b d detach\n' "$delay"
    sleep "$delay"
  done
}

present() {
  if command -v "$1" >/dev/null 2>&1; then
    printf '  %-14s ✅ %s\n' "$1" "$(command -v "$1")"
  else
    printf '  %-14s ⚪ missing\n' "$1"
  fi
}

short_git_branch() {
  cd "$REPO_DIR" 2>/dev/null && git branch --show-current 2>/dev/null || true
}

show_guide() {
  cat <<GUIDE
PAGE SHORTCUTS
  Ctrl-b w       page picker
  Ctrl-b n / p   next / previous page
  Ctrl-b 0-9     jump by bottom-bar number
  Ctrl-b arrows  move between panes
  Ctrl-b z       zoom current pane
  Ctrl-b d       detach safely

KEYBOARD DRILL
  1. Ctrl-b w, pick this page, Enter.
  2. Ctrl-b arrows into the scratch pane.
  3. Run one listed command, then Ctrl-b z to zoom/unzoom.
  4. Ctrl-b d detaches without killing the workspace.

CLI MODES
  cmux --no-attach                 build/check without stealing focus
  cmux --reset                     rebuild this workspace
  cmux --project=/path/to/repo     steer the deck at another repo
  cctx /path/to/repo               update the context card
  tmux attach -d -t $SESSION       return from plain CLI

SCRATCH RULE
  Every page has a zsh scratch pane. Use it for commands, tests, log tails, and recovery.
  Keep the main pane readable; do the messy work in scratch.

WINDOWS
  0 hub       workspace rail + overview + scratch
  1 editor    Neovim center surface
  2 project   cwd/project router and local docs
  3 browser   frontend/browser test surface
  4 agents    Agent Deck — one agent, one worktree (labeled slots)
  5 runway    git diff, test, build command runway
  6 review    diff review + test gates before accept
  7 obsidian  vault/project notes
  8 missions  attach mission-hermes / mission-openclaw (peer runtimes, not merged chat)
  9 scratch   free build/test/recovery shells

Boundary: Hermes/OpenClaw chat → mission-hermes / mission-openclaw. OSS/community → cockpit-community.

THIS PAGE
GUIDE
  case "$PAGE" in
    hub) printf '  Left rail is the outside-in project/session chooser. Center is the active surface.\n' ;;
    editor) printf '  Neovim owns editing. Scratch pane is for nearby commands and tests.\n' ;;
    project) printf '  Directory-aware router: cwd, git, ports, docs, and local commands.\n' ;;
    browser) printf '  Run dev server in scratch, open/check URL from the main pane.\n' ;;
    agents) printf '  Agent Deck slots: Claude, Codex, OpenCode, Goose, Cursor, Hermes-delegated, OpenClaw-delegated.\n' ;;
    runway) printf '  Command runway: git diff, test, build — training wheels beside Neovim.\n' ;;
    review) printf '  Diff review and test gates before accepting agent edits.\n' ;;
    missions) printf '  Attach separate mission controls. Do not merge Hermes/OpenClaw conversation here.\n' ;;
    obsidian) printf '  Jump into vault notes. Keep private details out of public commits.\n' ;;
    scratch) printf '  Free shells. Use this for experiments and cleanup.\n' ;;
    *) printf '  General cmux workbench pane.\n' ;;
  esac
}

show_editor_guide() {
  cat <<EDITOR
NEOVIM LEARNING RAIL
  Active appname:  $NVIM_APPNAME_VALUE
  Config path:     $HOME/.config/$NVIM_APPNAME_VALUE/init.lua
  Repo root:       $REPO_DIR

VS-Code-like mental map:
  Explorer      :Ex / :Explore / :Oil / :Neotree
  Quick open    :Telescope find_files
  Search        :Telescope live_grep or /text
  Problems      diagnostics + quickfix, :copen
  Terminal      tmux command runway below editor
  Source control git diff/status in scratch or Neogit

Neovim survival:
  i             insert mode
  Esc           normal mode
  :w            save
  :q            quit current window
  :wq           save and quit
  :q!           quit without saving
  /text Enter   search forward
  n / N         next / previous search result
  :e file       open file
  Ctrl-w h/j/k/l move between Neovim splits

File tree choices:
  Built-in      :Ex or :Explore
  Fuzzy files   :Telescope find_files
  Text search   :Telescope live_grep
  Oil.nvim      :Oil             if installed
  Neo-tree      :Neotree         if installed
  nvim-tree     :NvimTreeToggle  if installed

Themes:
  :colorscheme <Tab>    list installed themes
  :colorscheme habamax  built-in fallback
  :set background=dark  or light
  Kickstart: edit init.lua, restart, then :checkhealth

LSP / code intelligence:
  :Mason                installer/status if installed
  :LspInfo              attached language servers
  :checkhealth vim.lsp  LSP health
  gd                    go to definition
  gr                    references
  K                     hover docs
  <leader>rn            rename
  <leader>ca            code action
  [d / ]d               prev / next diagnostic

Compilers, tests, quickfix:
  :make                 run current makeprg
  :compiler <Tab>       discover compiler presets
  :copen                open quickfix/problems
  :cnext / :cprev       walk failures
  :grep pattern **/*    populate quickfix from grep
  Run repo tests in the command runway, not in guide.

Solidity / Foundry scratch commands:
  forge build
  forge test -vvv
  forge fmt --check
  forge coverage
  cast --help
  anvil                 scratch-only local chain; Ctrl-c stops

tmux around Neovim:
  Ctrl-b arrows move to scratch/guide panes
  Ctrl-b z      zoom Neovim or this rail
  Ctrl-b d      detach without quitting Neovim

Agent-edit safety:
  :set autoread?
  :checktime            reload files changed by agents
  Run :checktime before saving after agent edits.
  If warned, inspect git diff before :edit!.
  Never let two agents patch the same file blindly.
  Git diff is the truth layer between human and agents.

Practice loop:
  1. Open README.md with :e README.md
  2. Open tree/search with :Ex or :Telescope find_files
  3. Move to scratch and run git diff --stat
  4. Let an agent edit, then return and run :checktime
EDITOR
}

show_rail() {
  header 'Workspace rail'
  local branch
  branch="$(short_git_branch)"
  cat <<RAIL
PROJECT CARD
  name:  $CONTEXT_NAME
  cwd:   $REPO_DIR
  ctx:   $CONTEXT_KIND -> $CONTEXT_PATH
  git:   ${branch:-unknown}
  url:   $BROWSER_URL

SESSION CARDS
  0  hub       overview / outside-in chooser
  1  editor    Neovim center surface
  2  project   directory router
  3  browser   frontend test loop
  4  agents    Agent Deck slots (one agent, one worktree)
  5  runway    git diff, test, build
  6  review    diff gates before accept
  7  obsidian  vault / project docs
  8  missions  attach mission-hermes / mission-openclaw / cockpit-community
  9  scratch   loose terminals

WORKSPACE TOPOLOGIES
  Six cockpit surfaces on iMac cmux:
    1 DanOS Home               local danos registry/home
    2 Hermes Mission Control   mission-hermes
    3 OpenClaw Mission Control mission-openclaw
    4 Coding Workbench         cockpit-workbench (this session)
    5 Agent Deck               cockpit-workbench:agents
    6 OSS Radar / Community    cockpit-community

DIRECTORY IDEA
  The long-term target is a cwd-aware workspace:
    outside = project or Hermes conversation
    center  = active terminal/editor/agent surface
    context = changes as cwd moves through Hermes/OpenClaw/project tree

  Today: use window 2 project as the router and every command page has nearby scratch.
  Now: run `cctx` from any directory to print/update the context card.
  Optional: source the cockpit hook, then run `cctx-on` so cd updates the card.
  Escape hatches: CMUX_USE_CCTX_STATE=0 on launch, or CMUX_DYNAMIC_CONTEXT=0 in panes.
RAIL
  printf '\nCtrl-b 0-9 switches cards. Ctrl-b z zooms this rail.\n'
  exec zsh -l
}

show_hub() {
  printf 'Screenshot-derived design readout\n'
  cat <<'HUB'
  The photo is not just panes. It is a workspace deck:
    - left rail card = selected project/session identity
    - top tabs = surfaces inside that selected context
    - center = live agent terminal surface
    - command input = direct agent loop, not passive dashboard
    - empty space = intentional room for agent output and long-running work

  Translation for this repo:
    - tmux windows emulate the left rail cards
    - pane titles emulate surface tabs
    - Neovim is the editor surface, not the whole cockpit
    - Hermes/OpenClaw sessions are first-class surfaces, not external chores
    - scratch terminals sit beside command lists so Dan can act immediately

Flexible foundation principles
  1. Outside-in selection: start from project, Hermes conversation, or OpenClaw area.
  2. Center surface changes by context: editor, agent, browser, API, vault, PR.
  3. Scratch is always close to instructions.
  4. Browser testing is a first-class feedback loop, not an afterthought.
  5. Discord/Obsidian/GitHub are collaboration surfaces, with dry-run gates.
  6. Agents run in visible slots with git/worktree boundaries.

Current implementation
  - 10 windows, each with contextual scratch where commands are listed.
  - Hub uses left rail + center overview + scratch.
  - Agents page = Agent Deck slots only (Hermes/OpenClaw chat stays in mission controls).
  - Missions page = attach pointers to peer mission sessions + cockpit-community.
  - Browser page supports frontend/manual smoke tests.

Future native cmux migration
  Native cmux has vertical tabs, Ghostty terminal surfaces, notifications, browser panes, and session metadata.
  This tmux version now uses the same nouns so migration can become adapter work, not a rewrite.
HUB
}

show_project() {
  cd "$REPO_DIR"
  printf 'Project/router\n'
  printf '  cwd:        %s\n' "$PWD"
  printf '  git branch: %s\n' "$(git branch --show-current 2>/dev/null || printf unknown)"
  printf '  root:       '
  git rev-parse --show-toplevel 2>/dev/null || true
  printf '\nStatus\n'
  git status --short --branch 2>/dev/null || true
  printf '\nRelevant local surfaces\n'
  for rel in README.md docs/cmux.md docs/architecture.md docs/navigation.md config/ports.toml web/hermes/index.html web/openclaw/index.html; do
    [[ -e "$rel" ]] && printf '  ✅ %s\n' "$rel" || printf '  ⚪ %s\n' "$rel"
  done
  cat <<PROJECT

Directory-aware commands
  "$COCKPIT_BIN_DIR/cctx"
  "$COCKPIT_BIN_DIR/cctx" "$REPO_DIR"
  source "$COCKPIT_BIN_DIR/cctx-hook.zsh"
  cctx-on
  cctx-off
  cctx-refresh
  cd "$REPO_DIR"
  nvim .
  "$COCKPIT_BIN_DIR/ports" --registry "$COCKPIT_ROOT/config/ports.toml"
  "$COCKPIT_BIN_DIR/mission-web-hermes" --no-open
  "$COCKPIT_BIN_DIR/mission-web-openclaw" --no-open

Context router concept
  `cctx` notices cwd and refreshes:
    - project card
    - recommended commands
    - browser URL
    - Obsidian note
    - agent/worktree slots

Live-pane behavior
  cmux status pages reread the cctx state file on each refresh.
  Scratch shells do not magically move; they are command runways.
  This keeps automation useful without stealing your prompt or killing panes.
PROJECT
}

show_ops() {
  printf 'CMUX purpose\n'
  printf '  Workbench for editing, review, testing, GitHub/Discord discussion loops, and agent orchestration.\n'
  printf '  It references mission sessions instead of replacing them. Mission remains ops/control plane.\n\n'

  printf 'Live mission sessions\n'
  tmux list-sessions -F '  #{session_name}: windows=#{session_windows} attached=#{session_attached} created=#{session_created_string}' 2>/dev/null | sed -n '/mission/p;/cmux/p' || true

  cat <<'OPS'

Attach commands
  tmux attach -d -t mission-hermes      # Hermes production/stable cockpit
  tmux attach -d -t mission-openclaw    # OpenClaw dev/sandbox cockpit
  tmux attach -d -t cmux                # this coding workbench

Safe rebuilds
  mission-hermes --reset       # rebuild Hermes cockpit layout only
  mission-openclaw --reset     # rebuild OpenClaw cockpit layout only
  cmux --reset                 # rebuild coding workbench layout only

Important boundary
  mission-* observes gateways, cron, ports, logs, heartbeat.
  cmux edits code, reviews diffs, opens browser/test surfaces, and drafts discussions.
OPS
}

show_diff() {
  cd "$REPO_DIR"
  printf 'Git status\n'
  git status --short --branch || true
  printf '\nLast commit\n'
  git log -1 --pretty='  %h %G? %s%n  %b' || true
  printf '\nSync with upstream\n'
  branch="$(git branch --show-current 2>/dev/null || true)"
  if [[ -n "$branch" ]] && git rev-parse --verify "origin/$branch" >/dev/null 2>&1; then
    printf '  ahead behind: '
    git rev-list --left-right --count "HEAD...origin/$branch" || true
  else
    printf '  no origin/%s ref yet\n' "$branch"
  fi
  printf '\nDiff summary\n'
  git diff --stat || true
  printf '\nStaged summary\n'
  git diff --cached --stat || true
  cat <<'DIFF'

Review commands
  git diff --check
  git diff
  git diff --cached
  git log --oneline --decorate -10
  git add <paths>
  git commit -m "feat(scope): short summary" -m "Longer why/comments."
  git push

Optional diff viewers if installed
  git diff | delta
  git difftool --tool=difftastic
DIFF
}

show_browser() {
  printf 'Browser/test target\n'
  printf '  CMUX_BROWSER_URL=%s\n\n' "$BROWSER_URL"
  printf 'Browser tools\n'
  present open
  present curl
  present python3
  present browser-smoke
  present playwright
  present npx
  cat <<BROWSER

Open/smoke commands
  open "$BROWSER_URL"
  curl -I "$BROWSER_URL"
  browser-smoke --directory "$COCKPIT_ROOT/web" --path /hermes/ --expect 'Hermes Mission Control' --path /openclaw/ --expect 'OpenClaw Mission Control'
  python3 -m http.server 4175 --directory "$REPO_DIR/web"
  CMUX_BROWSER_URL=http://127.0.0.1:4175/hermes/ cmux --reset

Frontend testing loop
  1. Start dev/static server in the scratch pane.
  2. Open the URL in a browser.
  3. Run smoke checks.
  4. Capture failures in Obsidian or GitHub issue/PR notes.

Native cmux target
  When using the actual macOS cmux app, this becomes a browser surface/pane:
    cmux browser open-split "$BROWSER_URL"
    cmux browser screenshot --out /tmp/cmux-frontend.png

Testing rule
  Build/test passing is not the same as browser runtime verified.
BROWSER
}

show_agents() {
  printf 'Agent Deck | one agent, one worktree\n\n'
  present codex
  present claude
  present opencode
  present agent-deck
  present agent-worktree
  present a2a-bridge
  present git
  present tmux
  printf '\nLabeled delegation slots (not merged assistant panes):\n'
  printf '  Hermes-delegated coding  → mission-hermes or hermes --worktree\n'
  printf '  OpenClaw-delegated coding → mission-openclaw\n'
  printf '\nLive inventory\n'
  if [[ -x "$COCKPIT_BIN_DIR/cockpit-workspaces" ]]; then
    "$COCKPIT_BIN_DIR/cockpit-workspaces" inventory agent-deck 2>&1 | sed 's/^/  /'
  fi
  if [[ -x "$COCKPIT_BIN_DIR/agent-worktree" ]]; then
    printf '\nAgent worktree inventory\n'
    "$COCKPIT_BIN_DIR/agent-worktree" --repo "$REPO_DIR" list 2>&1 | sed 's/^/  /'
  fi
  if [[ -x "$COCKPIT_BIN_DIR/a2a-bridge" ]]; then
    printf '\nA2A local bridge card\n'
    "$COCKPIT_BIN_DIR/a2a-bridge" --repo "$REPO_DIR" agent-card 2>&1 | python3 -m json.tool 2>/dev/null | sed -n '1,60p' | sed 's/^/  /' || true
  fi
  cat <<'AGENTS'

Slots (launch exactly one agent per worktree):
  Claude Code slot    claude
  Codex slot          codex
  OpenCode slot       opencode
  Goose slot          goose          # when installed
  Cursor CLI slot     cursor agent   # when installed
  Hermes-delegated    hermes --worktree   # coding delegation only
  OpenClaw-delegated  openclaw tui        # sandbox coding delegation only

Launch patterns
  agent-worktree --repo "$REPO_DIR" list
  agent-worktree --repo "$REPO_DIR" create --slug short-task-name --agent codex --no-launch
  a2a-bridge --repo "$REPO_DIR" agent-card | python3 -m json.tool

Safety: one agent, one branch, one worktree. Review diffs before merge.
  Do not paste secrets into agent prompts or visible tmux panes.
AGENTS
}

show_runway() {
  cd "$REPO_DIR"
  printf 'Runway | git diff, test, build\n\n'
  git status --short --branch 2>/dev/null | sed -n '1,20p' || true
  printf '\n'
  git diff --stat 2>/dev/null | sed -n '1,15p' || true
  cat <<'RUNWAY'

Runway commands (copy to scratch pane):
  git diff --check
  git diff
  npm test / npm run build / forge test — project dependent
  ports --registry config/ports.toml
RUNWAY
}

show_review() {
  cd "$REPO_DIR"
  printf 'Review | diff, test, then accept\n\n'
  git status --short --branch 2>/dev/null || true
  printf '\n'
  git diff --check 2>&1 | sed -n '1,20p' || true
  cat <<'REV'

Accept gate checklist:
  1. git diff --check clean
  2. tests/build pass in runway pane
  3. no raw secrets in diff
  4. operator explicitly accepts agent edits
REV
}

show_missions() {
  printf 'Mission controls | peer AI runtimes (attach — do not merge here)\n\n'
  printf 'Hermes Tool / Hermes CLI Mission Control\n'
  printf '  tmux attach -d -t mission-hermes\n'
  printf '  mission-hermes\n\n'
  printf 'OpenClaw Tool / OpenClaw CLI Mission Control\n'
  printf '  tmux attach -d -t mission-openclaw\n'
  printf '  mission-openclaw\n\n'
  printf 'Open Source Radar / Community\n'
  printf '  tmux attach -d -t cockpit-community\n'
  printf '  cockpit-community\n\n'
  tmux list-sessions -F '  #{session_name}: windows=#{session_windows}' 2>/dev/null | \
    sed -n '/mission-hermes/p;/mission-openclaw/p;/cockpit-community/p' || true
  cat <<'M'

Boundary:
  Conversation, sessions, models, tools, auth, and ops for each runtime live in its mission session.
  This Coding Workbench page only provides attach pointers — no shared-secret leakage.
M
}

show_obsidian() {
  printf 'Vault\n'
  printf '  %s\n\n' "$VAULT"
  printf 'Project notes\n'
  for rel in \
    'projects/hermes-cli-cockpit' \
    'agent-hermes/notes/next-steps.md' \
    'agent-hermes/notes/open-items.md' \
    'resources/docs' \
    'resources/links'; do
    p="$VAULT/$rel"
    if [[ -e "$p" ]]; then
      printf '  ✅ %s\n' "$p"
    else
      printf '  ⚪ %s\n' "$p"
    fi
  done
  cat <<OBSIDIAN

Open commands
  nvim "$VAULT/projects/hermes-cli-cockpit"
  nvim "$VAULT/agent-hermes/notes/next-steps.md"
  open "obsidian://open?vault=hermes&file=projects/hermes-cli-cockpit"

Capture ideas
  - workspace design decisions
  - frontend/browser smoke failures
  - Discord discussion summaries
  - Hermes/OpenClaw session follow-ups

Boundary rule
  Public repo docs must be sanitized.
  Private hostnames, account details, Tailscale specifics, tokens, raw logs, and private Discord content stay in the vault.
OBSIDIAN
}

show_discord() {
  printf 'Discord API readiness\n'
  if [[ -n "${DISCORD_BOT_TOKEN:-}" ]]; then
    printf '  DISCORD_BOT_TOKEN: present\n'
  else
    printf '  DISCORD_BOT_TOKEN: missing from this pane env\n'
  fi
  if [[ -n "${DISCORD_CHANNEL_ID:-}" ]]; then
    printf '  DISCORD_CHANNEL_ID: present\n'
  else
    printf '  DISCORD_CHANNEL_ID: missing from this pane env\n'
  fi
  present curl
  present jq
  present python3
  cat <<'DISCORD'

Discussion workflow
  1. Draft content locally first in docs/cmux.md or an Obsidian project note.
  2. Pick an explicit channel/thread ID.
  3. Post only after confirming the destination and text.
  4. Verify by fetching the created message ID.

Safe API shape, do not paste tokens into terminal history:
  python3 scripts/post-discord-discussion.py --channel-id "$DISCORD_CHANNEL_ID" --file docs/cmux.md --dry-run

Discussion starter ideas
  - "Should cmux stay repo-specific or become a general cockpit generator?"
  - "What belongs in mission-hermes vs cmux? Ops plane vs coding plane."
  - "Agent orchestration safety: worktrees, diff gates, and PR handoff rules."
  - "How should native cmux browser panes map to our tmux fallback?"
DISCORD
}

page_commands() {
  case "$PAGE" in
    hub)
      cat <<CMDS
cd "$REPO_DIR"
git status --short --branch
cmux --no-attach
cmux --two-sessions --no-attach
CMDS
      ;;
    editor)
      cat <<CMDS
cd "$REPO_DIR"
git status --short --branch
git diff --stat
git diff --check
nvim .
nvim +':set autoread?' +':checktime' .

# Type inside Neovim:
#   :Ex
#   :Telescope find_files
#   :Telescope live_grep
#   :Mason
#   :LspInfo
#   :copen
#   :checktime

# Generic build/test probes:
[ -f package.json ] && npm test
[ -f package.json ] && npm run build
[ -f foundry.toml ] && forge build
[ -f foundry.toml ] && forge test -vvv
[ -f foundry.toml ] && forge fmt --check
CMDS
      ;;
    project)
      cat <<CMDS
cd "$REPO_DIR"
pwd
git status --short --branch
"$COCKPIT_BIN_DIR/cctx"
source "$COCKPIT_BIN_DIR/cctx-hook.zsh"
cctx-on
"$COCKPIT_BIN_DIR/ports" --registry "$COCKPIT_ROOT/config/ports.toml"
CMDS
      ;;
    browser)
      cat <<CMDS
cd "$REPO_DIR"
browser-smoke --directory "$COCKPIT_ROOT/web" --path /hermes/ --expect 'Hermes Mission Control' --path /openclaw/ --expect 'OpenClaw Mission Control'
python3 -m http.server 4175 --directory web
open "$BROWSER_URL"
curl -I "$BROWSER_URL"
CMDS
      ;;
    agents)
      cat <<CMDS
cd "$REPO_DIR"
cockpit-workspaces inventory agent-deck
agent-worktree --repo "$REPO_DIR" list
agent-worktree --repo "$REPO_DIR" create --slug short-task-name --agent codex --no-launch
a2a-bridge --repo "$REPO_DIR" agent-card | python3 -m json.tool
slug=short-task-name
branch="agent/\$slug"
worktree="/Users/openclaw/Code/worktrees/$(basename "$REPO_DIR")-\$slug"
git worktree add -b "\$branch" "\$worktree" main
cd "\$worktree"
codex        # or: claude / opencode / hermes --worktree / openclaw tui
CMDS
      ;;
    runway)
      cat <<CMDS
cd "$REPO_DIR"
git status --short --branch
git diff --stat
git diff --check
npm test 2>/dev/null || true
CMDS
      ;;
    review)
      cat <<CMDS
cd "$REPO_DIR"
git diff --check
git diff
git status --short --branch
CMDS
      ;;
    missions)
      cat <<CMDS
tmux attach -d -t mission-hermes
tmux attach -d -t mission-openclaw
tmux attach -d -t cockpit-community
mission-hermes
mission-openclaw
cockpit-community
CMDS
      ;;
    obsidian)
      cat <<CMDS
nvim "$VAULT/projects/hermes-cli-cockpit"
open "obsidian://open?vault=hermes&file=projects/hermes-cli-cockpit"
cd "$VAULT" && pwd
CMDS
      ;;
    *)
      cat <<CMDS
cd "$REPO_DIR"
pwd
git status --short --branch
CMDS
      ;;
  esac
}

show_command_scratch() {
  clear || true
  printf 'Scratch terminal for page: %s\n' "$PAGE"
  printf 'Repo: %s\n' "$REPO_DIR"
  printf 'Tip: copy commands from below, edit before running. This shell is intentionally disposable.\n'
  hr
  page_commands | sed 's/^/  /'
  hr
  cd "$REPO_DIR" 2>/dev/null || cd "$HOME"
  exec zsh -l
}

show_scratch() {
  clear || true
  printf 'Free scratch shell\n'
  printf 'Repo: %s\n' "$REPO_DIR"
  printf 'Use this for experiments, tests, log tails, and recovery commands.\n'
  hr
  cd "$REPO_DIR" 2>/dev/null || cd "$HOME"
  exec zsh -l
}

case "$ROLE" in
  guide)
    show_guide
    exec zsh -l
    ;;
  editor-guide)
    show_editor_guide
    exec zsh -l
    ;;
  rail) show_rail ;;
  hub) loop 'Workspace hub' 20 show_hub ;;
  project) loop 'Project/CWD router' 15 show_project ;;
  ops) loop 'Ops link' 10 show_ops ;;
  diff) loop 'Git diff/review' 8 show_diff ;;
  browser) loop 'Browser/test surface' 15 show_browser ;;
  agents) loop 'Agent orchestration' 15 show_agents ;;
  runway) loop 'Command runway' 12 show_runway ;;
  review) loop 'Diff review gates' 10 show_review ;;
  missions) loop 'Mission control attach' 15 show_missions ;;
  obsidian) loop 'Obsidian vault' 20 show_obsidian ;;
  command-scratch) show_command_scratch ;;
  scratch) show_scratch ;;
  *)
    header "Unknown role"
    printf 'Unknown cmux role: %s\n' "$ROLE"
    exit 2
    ;;
esac
