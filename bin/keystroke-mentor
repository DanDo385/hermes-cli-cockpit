#!/usr/bin/env python3
"""Adaptive keystroke mentor: context-ranked shortcuts, local state only (stdlib)."""
from __future__ import annotations

import argparse
import json
import os
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

DEFAULT_STATE = Path.home() / ".cache" / "hermes-cli-cockpit" / "keystroke-mentor.json"

CONTEXTS = (
    "nvim",
    "tmux",
    "git",
    "shell",
    "agent",
    "hermes",
    "openclaw",
    "github",
    "discord",
    "obsidian",
)

# action_id -> {context, keys, description, priority}
ACTIONS: dict[str, dict] = {
    "nvim.insert": {"context": "nvim", "keys": "i", "description": "Enter insert mode", "priority": 100},
    "nvim.normal": {"context": "nvim", "keys": "Esc", "description": "Return to normal mode", "priority": 99},
    "nvim.save": {"context": "nvim", "keys": ":w", "description": "Save current buffer", "priority": 98},
    "nvim.quit": {"context": "nvim", "keys": ":wq", "description": "Save and quit", "priority": 70},
    "nvim.search": {"context": "nvim", "keys": "/text", "description": "Search forward in buffer", "priority": 90},
    "nvim.next": {"context": "nvim", "keys": "n", "description": "Next search match", "priority": 75},
    "nvim.def": {"context": "nvim", "keys": "gd", "description": "Go to definition", "priority": 85},
    "nvim.docs": {"context": "nvim", "keys": "K", "description": "Hover documentation", "priority": 80},
    "tmux.prefix": {"context": "tmux", "keys": "Ctrl-b", "description": "tmux prefix key", "priority": 100},
    "tmux.picker": {"context": "tmux", "keys": "Ctrl-b w", "description": "Window/page picker", "priority": 95},
    "tmux.zoom": {"context": "tmux", "keys": "Ctrl-b z", "description": "Zoom current pane", "priority": 90},
    "tmux.detach": {"context": "tmux", "keys": "Ctrl-b d", "description": "Detach without killing session", "priority": 88},
    "tmux.next": {"context": "tmux", "keys": "Ctrl-b n", "description": "Next window", "priority": 70},
    "git.status": {"context": "git", "keys": "git status --short --branch", "description": "Compact status", "priority": 95},
    "git.diff": {"context": "git", "keys": "git diff", "description": "Working tree diff", "priority": 90},
    "git.diffstat": {"context": "git", "keys": "git diff --stat", "description": "Diff summary", "priority": 85},
    "git.check": {"context": "git", "keys": "git diff --check", "description": "Whitespace/conflict markers", "priority": 88},
    "shell.pwd": {"context": "shell", "keys": "pwd", "description": "Print working directory", "priority": 50},
    "shell.cd": {"context": "shell", "keys": "cd <path>", "description": "Change directory", "priority": 60},
    "agent.worktree": {"context": "agent", "keys": "agent-worktree create --slug <name>", "description": "One agent, one worktree", "priority": 90},
    "agent.review": {"context": "agent", "keys": "git diff --check && git diff", "description": "Review before accept", "priority": 92},
    "hermes.chat": {"context": "hermes", "keys": "hermes", "description": "Hermes conversation (mission-hermes)", "priority": 95},
    "hermes.sessions": {"context": "hermes", "keys": "hermes sessions list", "description": "List Hermes sessions", "priority": 85},
    "hermes.gateway": {"context": "hermes", "keys": "hermes gateway status", "description": "Hermes gateway health", "priority": 80},
    "openclaw.tui": {"context": "openclaw", "keys": "openclaw tui", "description": "OpenClaw conversation (mission-openclaw)", "priority": 95},
    "openclaw.gateway": {"context": "openclaw", "keys": "openclaw gateway status", "description": "OpenClaw gateway health", "priority": 80},
    "github.pr": {"context": "github", "keys": "gh pr status", "description": "PR and CI state", "priority": 90},
    "github.view": {"context": "github", "keys": "gh repo view", "description": "Repository overview", "priority": 75},
    "discord.dryrun": {"context": "discord", "keys": "post-discord-discussion.py --dry-run", "description": "Draft Discord post only", "priority": 95},
    "obsidian.vault": {"context": "obsidian", "keys": "cd ~/.hermes/workspace", "description": "Open vault root", "priority": 85},
}


def state_path() -> Path:
    raw = os.environ.get("KEYSTROKE_MENTOR_STATE", "").strip()
    return Path(raw) if raw else DEFAULT_STATE


def load_state(path: Path) -> dict:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {"boosts": {}}
    except (OSError, json.JSONDecodeError):
        return {"boosts": {}}
    if not isinstance(data, dict):
        return {"boosts": {}}
    data.setdefault("boosts", {})
    return data


def save_state(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def boost_score(data: dict, action_id: str) -> int:
    entry = data.get("boosts", {}).get(action_id, {})
    return int(entry.get("count", 0)) * 5


def rank_actions(context: str, data: dict, limit: int) -> list[tuple[str, dict, int]]:
    ranked: list[tuple[str, dict, int]] = []
    for aid, meta in ACTIONS.items():
        if meta.get("context") != context:
            continue
        score = int(meta.get("priority", 0)) + boost_score(data, aid)
        ranked.append((aid, meta, score))
    ranked.sort(key=lambda x: (-x[2], x[0]))
    return ranked[:limit]


def cmd_list_contexts(_: argparse.Namespace) -> int:
    for ctx in CONTEXTS:
        count = sum(1 for m in ACTIONS.values() if m.get("context") == ctx)
        print(f"{ctx}\t{count} actions")
    return 0


def cmd_boost(args: argparse.Namespace) -> int:
    aid = args.action_id.strip()
    if aid not in ACTIONS:
        print(f"keystroke-mentor: unknown action id: {aid}", file=sys.stderr)
        print("Use list-contexts and try ids like nvim.save or tmux.zoom", file=sys.stderr)
        return 2
    path = state_path()
    data = load_state(path)
    boosts = data.setdefault("boosts", {})
    entry = boosts.setdefault(aid, {"count": 0})
    entry["count"] = int(entry.get("count", 0)) + 1
    entry["last"] = datetime.now(timezone.utc).isoformat()
    save_state(path, data)
    print(f"boosted {aid} (count={entry['count']})")
    return 0


def print_ranked(context: str, limit: int, data: dict) -> None:
    print(f"Keystroke mentor :: {context}")
    print("-" * 40)
    rows = rank_actions(context, data, limit)
    if not rows:
        print(f"No actions for context {context!r}.")
        print(f"Known contexts: {', '.join(CONTEXTS)}")
        return
    for aid, meta, score in rows:
        print(f"  [{score:3d}] {meta['keys']:<28} {meta['description']}")
        print(f"        id={aid}")
    print()
    print("Boost: bin/keystroke-mentor boost <action-id>")


def cmd_show(args: argparse.Namespace) -> int:
    ctx = args.context.strip().lower()
    if ctx not in CONTEXTS:
        print(f"keystroke-mentor: unknown context: {ctx}", file=sys.stderr)
        print(f"Known contexts: {', '.join(CONTEXTS)}", file=sys.stderr)
        return 2
    data = load_state(state_path())
    print_ranked(ctx, args.limit, data)
    return 0


def cmd_watch(args: argparse.Namespace) -> int:
    ctx = args.context.strip().lower()
    if ctx not in CONTEXTS:
        print(f"keystroke-mentor: unknown context: {ctx}", file=sys.stderr)
        return 2
    interval = max(5, int(args.interval))
    path = state_path()
    try:
        while True:
            data = load_state(path)
            print("\033[2J\033[H", end="")
            print_ranked(ctx, args.limit, data)
            print(f"Refresh: every {interval}s   Ctrl-c to stop")
            time.sleep(interval)
    except KeyboardInterrupt:
        print("\nkeystroke-mentor: watch stopped")
        return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="Context-ranked keystroke mentor (no network)")
    sub = p.add_subparsers(dest="command")

    sub.add_parser("list-contexts", help="list supported contexts")

    boost = sub.add_parser("boost", help="increment usage boost for an action id")
    boost.add_argument("action_id", help="e.g. nvim.save")

    show = sub.add_parser("show", help="print ranked shortcuts (default)")
    show.add_argument("--context", default="nvim", help="context name")
    show.add_argument("--limit", type=int, default=8)

    p.add_argument("--context", default="", help="context for default show/watch")
    p.add_argument("--limit", type=int, default=8)
    p.add_argument("--watch", action="store_true", help="loop refresh")
    p.add_argument("--interval", type=int, default=30, help="watch interval seconds")
    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.command == "list-contexts":
        return cmd_list_contexts(args)
    if args.command == "boost":
        return cmd_boost(args)

    ctx = (args.context or "nvim").strip().lower()
    if args.command == "show":
        args.context = ctx
        return cmd_show(args)

    if args.watch or "--watch" in (argv or sys.argv):
        if not ctx:
            print("keystroke-mentor: --watch requires --context", file=sys.stderr)
            return 2
        ns = argparse.Namespace(context=ctx, limit=args.limit, interval=args.interval)
        return cmd_watch(ns)

    if not ctx:
        print("keystroke-mentor: specify --context or use list-contexts", file=sys.stderr)
        return 2
    ns = argparse.Namespace(context=ctx, limit=args.limit)
    return cmd_show(ns)


if __name__ == "__main__":
    raise SystemExit(main())
