#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="${COCKPIT_REPO_DIR:-/Users/openclaw/Code/hermes-cli-cockpit}"
export COCKPIT_REPO_DIR="$REPO_DIR"
export COCKPIT_SESSION="${COCKPIT_SESSION:-cockpit-community}"
export COCKPIT_TITLE="${COCKPIT_TITLE:-Open Source Radar / Community}"
export COCKPIT_GITHUB_REPO="${COCKPIT_GITHUB_REPO:-NousResearch/hermes-agent}"
