#!/usr/bin/env bash
set -euo pipefail

ROLE="${1:-overview}"
PAGE="${2:-${ROLE}}"
AGENT="${MISSION_AGENT:-hermes}"
TITLE="${MISSION_TITLE:-Hermes Mission Control}"
REPO_DIR="${MISSION_REPO_DIR:-/Users/openclaw/Code/hermes-cli-cockpit}"
HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
OPENCLAW_PROFILE_FLAG="${OPENCLAW_PROFILE_FLAG-}"
OPENCLAW_MODE="${OPENCLAW_MODE:-normal}"
OPENCLAW_LOG_FILE="${OPENCLAW_LOG_FILE:-/tmp/openclaw/openclaw-$(date +%F).log}"
HERMES_LOG_DIR="${HERMES_LOG_DIR:-$HERMES_HOME/logs}"
WEB_PORT="${MISSION_WEB_PORT:-}"
GATEWAY_PORT="${MISSION_GATEWAY_PORT:-}"
BROWSER_PORT="${MISSION_BROWSER_PORT:-}"
SESSION_NAME="${MISSION_SESSION:-mission-${AGENT}}"

hr() { printf '%*s\n' "${COLUMNS:-100}" '' | tr ' ' '-'; }
now() { date '+%Y-%m-%d %H:%M:%S %Z'; }
agent_label() { printf '%s' "$(printf '%s' "$AGENT" | tr '[:lower:]' '[:upper:]')"; }

header() {
  clear || true
  printf '%s :: %s\n' "$TITLE" "$1"
  printf 'Agent: %s   Host: %s   Time: %s\n' "$(agent_label)" "$(hostname)" "$(now)"
  if command -v tailscale >/dev/null 2>&1; then
    local tip
    tip="$(tailscale ip -4 2>/dev/null | head -1 || true)"
    [[ -n "$tip" ]] && printf 'Tailscale: %s\n' "$tip"
  fi
  hr
  printf '\n'
}

loop() {
  local title="$1" delay="$2"
  shift 2
  while true; do
    header "$title"
    "$@" 2>&1 || true
    printf '\n'
    hr
    printf 'Refresh: every %ss   Ctrl-c stops this pane command   Ctrl-b d detach   Ctrl-b z zoom\n' "$delay"
    sleep "$delay"
  done
}

agent_cmd() {
  if [[ "$AGENT" == "openclaw" ]]; then
    if [[ -n "$OPENCLAW_PROFILE_FLAG" ]]; then
      printf 'openclaw %s' "$OPENCLAW_PROFILE_FLAG"
    else
      printf 'openclaw'
    fi
  else
    printf 'hermes'
  fi
}

run_agent() {
  if [[ "$AGENT" == "openclaw" ]]; then
    if [[ -n "$OPENCLAW_PROFILE_FLAG" ]]; then
      command openclaw "$OPENCLAW_PROFILE_FLAG" "$@"
    else
      command openclaw "$@"
    fi
  else
    command hermes "$@"
  fi
}

unsupported_state() {
  local feature="$1" hint="${2:-Check OpenClaw docs or configure the equivalent Hermes surface separately.}"
  printf '%s: unsupported/not configured\n\n' "$feature"
  printf 'Runtime owner: %s\n' "$(agent_label)"
  printf 'Peer runtime:  %s (use mission-%s for that surface)\n\n' \
    "$( [[ "$AGENT" == openclaw ]] && printf Hermes || printf OpenClaw )" \
    "$( [[ "$AGENT" == openclaw ]] && printf hermes || printf openclaw )"
  printf '%s\n' "$hint"
  printf '\nBoundary: this pane stays visible even when the feature is missing.\n'
}

openclaw_supports() {
  if [[ "$AGENT" != "openclaw" ]]; then
    return 0
  fi
  openclaw $OPENCLAW_PROFILE_FLAG "$@" >/dev/null 2>&1
}

show_page_guide() {
  local page="$PAGE" owner
  owner="$(agent_label)"
  cat <<GUIDE
PAGE SHORTCUTS
  Ctrl-b w       page picker
  Ctrl-b n / p   next / previous page
  Ctrl-b 0-9     jump by bottom-bar number
  Ctrl-b arrows  move between panes
  Ctrl-b z       zoom current pane
  Ctrl-b d       detach safely

WINDOWS ($owner mission control — peer surface, not merged with Hermes/OpenClaw)
  0 chat       $owner | conversation
  1 sessions   $owner Sessions | list, browse, continue, resume, export
  2 models     $owner Models | default, aux, cron routes
  3 tools      $owner Tools | tools, skills, MCPs
  4 secrets    $owner 1Password | no raw secrets
  5 notes      $owner Notes | vault runbooks
  6 gateway    $owner Ops | gateway health
  7 cron       $owner Ops | cron + latest output
  8 ops        $owner Ops | logs, ports, launchd
  9 scratch    $owner Commands | operator sheet

THIS PAGE
GUIDE
  case "$page" in
    chat) printf '  Type to %s here. Conversation belongs to %s only.\n' "$AGENT" "$owner" ;;
    sessions) printf '  Session store for %s. Export/resume where supported.\n' "$owner" ;;
    models) printf '  Model registry and route awareness for %s.\n' "$owner" ;;
    tools) printf '  Tools, skills, and MCP status for %s.\n' "$owner" ;;
    secrets) printf '  op whoami / vault metadata only. Never print raw secrets.\n' ;;
    notes) printf '  Obsidian runbooks at ~/.hermes/workspace — label notes by runtime owner.\n' ;;
    gateway) printf '  Gateway health for %s. Hermes owns production launchd unless explicitly shifted.\n' "$owner" ;;
    cron) printf '  Cron registry and latest outputs for %s.\n' "$owner" ;;
    ops) printf '  Logs, ports, processes, launchd/service health for %s.\n' "$owner" ;;
    scratch) printf '  Command sheet shell. Pane titles name the owning runtime.\n' ;;
    *) printf '  General %s mission-control pane.\n' "$owner" ;;
  esac
}

show_models() {
  if [[ "$AGENT" == "hermes" ]]; then
    printf 'Hermes model registry / route awareness\n\n'
    if hermes models list >/dev/null 2>&1; then
      hermes models list 2>&1 | sed -n '1,80p' || true
    elif hermes routes list >/dev/null 2>&1; then
      hermes routes list 2>&1 | sed -n '1,80p' || true
    else
      printf 'CLI model list unavailable; reading registry hints from config when present.\n\n'
      for f in "$HERMES_HOME/config/models.toml" "$HERMES_HOME/config/routes.toml" "$HERMES_HOME/models.json"; do
        [[ -f "$f" ]] && printf '  registry file: %s\n' "$f"
      done
    fi
    printf '\nCron route summary (auxiliary/cron paths)\n'
    show_hermes_cron_routes
    cat <<'HM'

Useful Hermes model commands:
  hermes models list          # when available
  hermes routes list          # when available
  hermes cron list            # inspect cron-owned routes
HM
  else
    printf 'OpenClaw Models | provider, config, routes\n\n'
    if openclaw $OPENCLAW_PROFILE_FLAG models list >/dev/null 2>&1; then
      openclaw $OPENCLAW_PROFILE_FLAG models list 2>&1 | sed -n '1,80p' || true
    elif openclaw $OPENCLAW_PROFILE_FLAG config show >/dev/null 2>&1; then
      openclaw $OPENCLAW_PROFILE_FLAG config show 2>&1 | sed -n '1,80p' || true
    else
      unsupported_state "OpenClaw model registry / route awareness" \
        "Try: openclaw config show ; openclaw --dev models list"
    fi
  fi
}

show_tools() {
  if [[ "$AGENT" == "hermes" ]]; then
    printf 'Hermes Tools | tools, skills, MCPs\n\n'
    if hermes tools list >/dev/null 2>&1; then
      printf 'Tools registry\n'
      hermes tools list 2>&1 | sed -n '1,60p' || true
      printf '\n'
    fi
    if hermes skills list >/dev/null 2>&1; then
      printf 'Skills registry\n'
      hermes skills list 2>&1 | sed -n '1,60p' || true
      printf '\n'
    fi
    if hermes mcp list >/dev/null 2>&1; then
      printf 'MCP servers\n'
      hermes mcp list 2>&1 | sed -n '1,60p' || true
      printf '\n'
    else
      printf 'MCP CLI list unavailable; use gateway/toolset inspection or config under ~/.hermes\n'
    fi
    cat <<'HT'

Useful Hermes capability commands:
  hermes tools list
  hermes skills list
  hermes mcp list
  hermes mcp test <name>      # when available
HT
  else
    printf 'OpenClaw Tools | capabilities, MCPs, auth\n\n'
    local any=0
    if openclaw $OPENCLAW_PROFILE_FLAG tools list >/dev/null 2>&1; then
      openclaw $OPENCLAW_PROFILE_FLAG tools list 2>&1 | sed -n '1,60p' || true
      any=1
    fi
    if openclaw $OPENCLAW_PROFILE_FLAG mcp list >/dev/null 2>&1; then
      printf '\nMCP\n'
      openclaw $OPENCLAW_PROFILE_FLAG mcp list 2>&1 | sed -n '1,60p' || true
      any=1
    fi
    if [[ "$any" -eq 0 ]]; then
      unsupported_state "OpenClaw tools/skills/MCP registry" \
        "Try: openclaw --dev tools list ; openclaw --dev mcp list"
    fi
  fi
}

show_notes() {
  local vault="${HERMES_HOME}/workspace"
  printf '%s Notes | vault runbooks\n\n' "$(agent_label)"
  printf 'Canonical vault: %s\n\n' "$vault"
  if [[ "$AGENT" == "openclaw" ]]; then
    printf 'Boundary notes (OpenClaw owns vs Hermes owns)\n'
    cat <<'BN'
  OpenClaw owns: OpenClaw gateway/lab runtime, OpenClaw sessions, OpenClaw credentials scope.
  Hermes owns: production launchd gateway, Hermes cron dispatch, Hermes session store.
  Shared read-only: Obsidian vault at ~/.hermes/workspace — label notes by runtime owner.
  Never share raw secrets between Hermes and OpenClaw panes.
BN
  fi
  for rel in \
    "projects/hermes-cli-cockpit" \
    "agent-hermes/notes/next-steps.md" \
    "agent-hermes/notes/open-items.md"; do
    local p="$vault/$rel"
    if [[ -e "$p" ]]; then
      printf '  ✅ %s\n' "$p"
    else
      printf '  ⚪ %s\n' "$p"
    fi
  done
  if [[ "$AGENT" == "openclaw" ]]; then
    local oc="$vault/projects/openclaw"
    [[ -e "$oc" ]] && printf '  ✅ %s\n' "$oc" || printf '  ⚪ %s (create for OpenClaw runbooks)\n' "$oc"
  fi
  cat <<NOTES

Open commands (metadata only — no secret paths printed):
  cd "$vault" && pwd
  nvim "$vault/projects/hermes-cli-cockpit"
  open "obsidian://open?vault=hermes&file=projects/hermes-cli-cockpit"
NOTES
}

show_ops() {
  printf '%s Ops | logs, ports, processes, launchd\n\n' "$(agent_label)"
  if [[ "$AGENT" == "hermes" ]]; then
    if command -v hermes-health >/dev/null 2>&1; then
      hermes-health 2>&1 | sed -n '1,50p' || true
      printf '\n'
    fi
    printf 'Hermes launchd services\n'
    launchctl list 2>/dev/null | grep -E 'ai\.hermes\.(gateway|heartbeat)' || true
    printf '\nRecent gateway log tail\n'
    tail -n 25 "$HERMES_LOG_DIR/gateway.log" 2>/dev/null || printf '  gateway.log unavailable\n'
  else
    openclaw $OPENCLAW_PROFILE_FLAG gateway status 2>&1 | sed -n '1,20p' || true
    printf '\nOpenClaw log tail\n'
    mkdir -p "$(dirname "$OPENCLAW_LOG_FILE")"
    tail -n 25 "$OPENCLAW_LOG_FILE" 2>/dev/null || printf '  %s unavailable\n' "$OPENCLAW_LOG_FILE"
    if ! openclaw $OPENCLAW_PROFILE_FLAG system heartbeat --help >/dev/null 2>&1; then
      printf '\n'
      unsupported_state "OpenClaw launchd/service heartbeat panel" "Use gateway status and logs above."
    fi
  fi
  printf '\nPorts / listeners\n'
  show_ports
  printf '\nRelated processes\n'
  ps axww -o pid,ppid,etime,command | grep -E 'hermes_cli|openclaw-gateway|/usr/local/bin/openclaw|mission-agent-pane' | grep -v grep | sed -n '1,40p' || true
}

show_gateway() {
  if [[ "$AGENT" == "openclaw" ]]; then
    openclaw $OPENCLAW_PROFILE_FLAG gateway status 2>&1 || true
    cat <<'OCG'

Useful OpenClaw gateway commands:
  Normal mode (use OpenClaw as an assistant):
    openclaw gateway status
    openclaw gateway health
    openclaw gateway run
    openclaw gateway start      # persistent service path; operator approval required
    openclaw gateway install    # persistent service install; operator approval required

  Lab/debug mode (crash/queue/source investigation):
    openclaw --dev gateway status
    openclaw --dev gateway health
    openclaw --dev gateway run --port 19001 --bind loopback --auth none --allow-unconfigured --verbose --compact
    openclaw --dev gateway run --port 19001 --bind tailnet --auth token --allow-unconfigured --verbose --compact
    openclaw --dev dashboard --no-open
    openclaw --dev logs --limit 120 --plain

Safety:
  Normal mode is allowed when Dan chooses to use OpenClaw.
  Do not install/start/stop a persistent OpenClaw service from a pane without explicit operator approval.
  Loopback is safest for lab mode. Use cmux SSH browser routing or SSH/Tailscale forwarding to view from iMac.
  If exposing directly to the tailnet, prefer auth=token and never paste tokens into visible panes.
OCG
  else
    hermes gateway status 2>&1 || true
    cat <<'HG'

Useful Hermes gateway commands:
  hermes gateway status
  hermes gateway start
  hermes gateway stop
  hermes gateway restart
  tail -n 80 ~/.hermes/logs/gateway.log
  tail -n 120 ~/.hermes/logs/gateway.error.log

Safety:
  Hermes is currently the stable launchd-owned production gateway. Do not run a second long-lived foreground gateway unless debugging.
  If Discord shows repeated 429/503/no healthy upstream/overflow errors, do NOT restart-loop.
  Break the launchd retry loop, wait for cooldown, then start once:
    launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/ai.hermes.gateway.plist 2>/dev/null || true
    # wait at least 5 minutes, then:
    hermes gateway start
HG
  fi
}

show_hermes_cron_routes() {
  HERMES_HOME="$HERMES_HOME" python3 - <<'PY' 2>/dev/null || true
import json, os
from pathlib import Path

home = Path(os.environ.get('HERMES_HOME') or (Path.home()/'.hermes'))
jobs_path = home/'cron/jobs.json'
out_root = home/'cron/output'
if not jobs_path.exists():
    print('cron registry not found:', jobs_path)
    raise SystemExit

jobs = json.loads(jobs_path.read_text()).get('jobs', [])
print('Cron route + latest-output summary')
for j in jobs:
    if not j.get('enabled', True):
        continue
    jid = j.get('id') or '<no-id>'
    name = j.get('name') or '<unnamed>'
    provider = j.get('provider')
    model = j.get('model')
    route = '/'.join(str(x) for x in (provider, model) if x) or '<inherits default>'
    last_status = j.get('last_status') or '<never>'
    last_error = j.get('last_error') or ''
    stale_gemini = 'gemini' in last_error.lower() and 'gemini' not in route.lower()
    active_gemini = 'gemini' in route.lower()
    output_dir = out_root/jid
    files = sorted(output_dir.glob('*.md'), key=lambda p: p.stat().st_mtime, reverse=True) if output_dir.exists() else []
    latest = str(files[0]) if files else '<no output file>'
    mutating = any(word in name.lower() for word in ['sync', 'archive', 'git', 'deploy', 'publish'])
    if active_gemini:
        flag = 'RED active Gemini route'
    elif stale_gemini:
        flag = 'YELLOW stale Gemini last_error'
    elif str(last_status).lower() == 'error':
        flag = 'RED last run errored'
    else:
        flag = 'OK'
    side = '  SIDE-EFFECTS' if mutating else ''
    print(f'- {jid}  {name}{side}')
    print(f'  route={route}  last={last_status}  {flag}')
    print(f'  next={j.get("next_run_at")}')
    print(f'  latest_output={latest}')
PY
}

show_cron() {
  if [[ "$AGENT" == "openclaw" ]]; then
    if openclaw $OPENCLAW_PROFILE_FLAG cron status >/dev/null 2>&1; then
      openclaw $OPENCLAW_PROFILE_FLAG cron status 2>&1 || true
      printf '\n'
      openclaw $OPENCLAW_PROFILE_FLAG cron list 2>&1 || true
    else
      unsupported_state "OpenClaw cron scheduler" "Try: openclaw --dev cron list"
    fi
    cat <<'OCC'

Useful OpenClaw cron commands:
  openclaw --dev cron list
  openclaw --dev cron show <id>
  openclaw --dev cron run <id>
  openclaw --dev cron runs <id>
  openclaw --dev cron enable|disable <id>
OCC
  else
    hermes cron status 2>&1 || true
    printf '\n'
    hermes cron list 2>&1 || true
    printf '\n'
    show_hermes_cron_routes
    cat <<'HCRON'

Useful Hermes cron commands:
  hermes cron list
  hermes cron status
  hermes cron edit <job_id>
  hermes cron run <job_id>
  hermes cron pause|resume <job_id>

Cron amendment flow:
  hermes cron edit <job_id> --schedule '0 22 * * *'
  hermes cron edit <job_id> --prompt 'new full prompt'
  hermes cron edit <job_id> --name 'new name'
  hermes cron edit <job_id> --workdir /absolute/path
HCRON
  fi
}

show_sessions() {
  if [[ "$AGENT" == "openclaw" ]]; then
    if openclaw $OPENCLAW_PROFILE_FLAG sessions --all-agents >/dev/null 2>&1; then
      openclaw $OPENCLAW_PROFILE_FLAG sessions --all-agents 2>&1 | sed -n '1,120p' || true
    elif openclaw $OPENCLAW_PROFILE_FLAG sessions >/dev/null 2>&1; then
      openclaw $OPENCLAW_PROFILE_FLAG sessions 2>&1 | sed -n '1,120p' || true
    else
      unsupported_state "OpenClaw session list" "Try: openclaw --dev sessions --all-agents"
    fi
    cat <<'OCS'

Useful OpenClaw session commands (where supported):
  openclaw --dev sessions
  openclaw --dev sessions --all-agents
  openclaw --dev sessions --active 120
  openclaw --dev sessions cleanup

Export/resume parity with Hermes may be unsupported/not configured — check CLI help before assuming.
OCS
  else
    hermes sessions list 2>&1 | sed -n '1,80p' || true
    printf '\n'
    hermes sessions stats 2>&1 | sed -n '1,40p' || true
    cat <<'HS'

Useful Hermes session commands:
  hermes sessions list
  hermes sessions browse
  hermes sessions stats
  hermes sessions export /tmp/hermes-sessions.jsonl
HS
  fi
  printf '\nLive related processes\n'
  ps axww -o pid,ppid,etime,command | grep -E 'hermes_cli|openclaw-gateway|/usr/local/bin/openclaw|mission-agent-pane|mission-pane' | grep -v grep | sed -n '1,80p' || true
  cat <<'CLEANUP'

Safe stale cleanup rule:
  1. Inspect first. Keep the launchd-owned Hermes gateway alive unless intentionally restarting it.
  2. Stop only obviously stale CLI/TUI/dev gateway PIDs:
       kill -TERM <pid>
       sleep 3
       ps -p <pid> -o pid,etime,command
       kill -KILL <pid>    # only if TERM failed
  3. For Hermes orphaned SQLite rows, close abandoned sessions without deleting history and exclude the active session:
       sqlite3 ~/.hermes/state.db "UPDATE sessions SET ended_at = strftime('%s','now'), end_reason = 'user_canceled_cleanup' WHERE ended_at IS NULL AND id != '<active_session_id>';"
CLEANUP
}

show_heartbeat() {
  if [[ "$AGENT" == "openclaw" ]]; then
    openclaw $OPENCLAW_PROFILE_FLAG system presence 2>&1 | sed -n '1,100p' || true
    printf '\nOpenClaw heartbeat commands:\n'
    printf '  openclaw --dev system heartbeat --help\n'
    printf '  openclaw --dev system event --help\n'
  else
    printf 'Hermes launchd heartbeat\n'
    launchctl list 2>/dev/null | grep -E 'ai\.hermes\.heartbeat|ai\.hermes\.gateway' || true
    printf '\nRecent heartbeat logs\n'
    latest="$(ls -t "$HERMES_HOME"/workspace/logs/heartbeat/*.md 2>/dev/null | head -1 || true)"
    if [[ -n "$latest" ]]; then
      printf 'Latest: %s\n\n' "$latest"
      tail -n 80 "$latest" 2>/dev/null || true
    else
      printf 'No heartbeat vault log found.\n'
    fi
  fi
}

show_ports() {
  if command -v ports >/dev/null 2>&1; then
    ports 2>&1 | sed -n '1,140p'
  else
    lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | sed -n '1,140p'
  fi
  printf '\nPort-specific probes:\n'
  [[ -n "$WEB_PORT" ]] && printf '  port-who %s\n' "$WEB_PORT"
  [[ -n "$GATEWAY_PORT" ]] && printf '  port-who %s\n' "$GATEWAY_PORT"
  [[ -n "$BROWSER_PORT" ]] && printf '  port-who %s\n' "$BROWSER_PORT"
}

show_secrets() {
  printf 'Safe credential readiness only. This page must not print tokens, env dumps, private key material, or op item values.\n\n'
  printf '1Password CLI\n'
  if command -v op >/dev/null 2>&1; then
    if op whoami >/tmp/mission-agent-op.$$ 2>&1; then
      user_type="$(sed -n 's/^User Type:[[:space:]]*//p' /tmp/mission-agent-op.$$ | head -1)"
      printf '  installed: yes\n'
      printf '  authenticated: yes%s\n' "${user_type:+ ($user_type)}"
    else
      printf '  installed: yes\n'
      printf '  authenticated: no\n'
    fi
    rm -f /tmp/mission-agent-op.$$
  else
    printf '  installed: no\n'
  fi

  printf '\nService account env\n'
  if [[ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]]; then
    printf '  OP_SERVICE_ACCOUNT_TOKEN: set (value hidden)\n'
  else
    printf '  OP_SERVICE_ACCOUNT_TOKEN: unset in this pane\n'
    printf '  If expected, refresh tmux env or load from your shell/launch context.\n'
  fi

  printf '\nSSH agent\n'
  if [[ -z "${SSH_AUTH_SOCK:-}" ]]; then
    printf '  SSH_AUTH_SOCK: unset\n'
  else
    printf '  SSH_AUTH_SOCK: set\n'
    [[ -S "$SSH_AUTH_SOCK" ]] && printf '  socket: reachable\n' || printf '  socket: not reachable\n'
  fi
  out="$(ssh-add -l 2>&1 || true)"
  if printf '%s\n' "$out" | grep -qi 'no identities'; then
    printf '  identities: 0 loaded\n'
  elif printf '%s\n' "$out" | grep -Eq 'SHA256|ssh-ed25519|RSA|ED25519'; then
    count="$(printf '%s\n' "$out" | wc -l | tr -d ' ')"
    printf '  identities: %s loaded (fingerprints hidden)\n' "$count"
  else
    printf '  identities: status unclear\n'
  fi
}

follow_logs() {
  if [[ "$AGENT" == "openclaw" ]]; then
    mkdir -p "$(dirname "$OPENCLAW_LOG_FILE")"
    touch "$OPENCLAW_LOG_FILE"
    header "logs"
    printf 'Following OpenClaw file log: %s\n' "$OPENCLAW_LOG_FILE"
    printf 'For RPC log tail: openclaw --dev logs --follow --plain\n'
    printf 'Reasoning/tool visibility: use verbose/raw-stream flags only where supported. Hidden model chain-of-thought is not guaranteed or exposed.\n'
    hr
    tail -n 120 -F "$OPENCLAW_LOG_FILE"
  else
    mkdir -p "$HERMES_LOG_DIR"
    touch "$HERMES_LOG_DIR/gateway.log" "$HERMES_LOG_DIR/gateway.error.log"
    header "logs"
    printf 'Following Hermes gateway + error logs.\n'
    printf 'Reasoning/tool visibility: in chat, use /verbose and /reasoning show if available; logs show tool/platform/runtime events, not hidden model chain-of-thought.\n'
    hr
    tail -n 80 -F "$HERMES_LOG_DIR/gateway.log" "$HERMES_LOG_DIR/gateway.error.log"
  fi
}

open_chat() {
  header "chat"
  printf 'Starting %s interactive CLI/TUI...\n' "$AGENT"
  printf 'Navigation stays tmux-level: Ctrl-b w picker, Ctrl-b 1 overview, Ctrl-b z zoom.\n\n'
  if [[ "$AGENT" == "openclaw" ]]; then
    exec openclaw $OPENCLAW_PROFILE_FLAG tui
  else
    exec hermes
  fi
}

open_shell() {
  header "$PAGE shell"
  printf 'Scratch/control shell for %s.\n\n' "$AGENT"
  case "$PAGE" in
    gateway) printf 'Try: %s gateway status\n' "$(agent_cmd)" ;;
    cron) printf 'Try: %s cron list\n' "$(agent_cmd)" ;;
    sessions) printf 'Try: %s sessions%s\n' "$(agent_cmd)" "$([[ "$AGENT" == hermes ]] && printf ' list' || true)" ;;
    heartbeat) printf 'Try: %s system heartbeat --help  # OpenClaw only\n' "$(agent_cmd)" ;;
    ports) printf 'Try: ports ; port-who <port>\n' ;;
    secrets) printf 'Try: op whoami ; echo ${OP_SERVICE_ACCOUNT_TOKEN:+OP token set}; echo ${SSH_AUTH_SOCK:+SSH sock set}\n' ;;
    logs) printf 'Try: tail -F <log-file>\n' ;;
    *) printf 'Try: %s --help ; ports ; pwd\n' "$(agent_cmd)" ;;
  esac
  printf '\n'
  exec zsh -l
}

case "$ROLE" in
  chat) open_chat ;;
  models) loop "models" 30 show_models ;;
  tools) loop "tools" 30 show_tools ;;
  notes) loop "notes" 45 show_notes ;;
  ops) loop "ops" 20 show_ops ;;
  gateway) loop "gateway" 15 show_gateway ;;
  cron) loop "cron" 30 show_cron ;;
  sessions) loop "sessions" 45 show_sessions ;;
  ports) loop "ports" 20 show_ports ;;
  secrets|security) loop "secrets readiness" 60 show_secrets ;;
  logs) follow_logs ;;
  guide) loop "shortcuts" 60 show_page_guide ;;
  shell) open_shell ;;
  command-sheet|scratch) open_shell ;;
  *) printf 'Unknown mission-agent-pane role: %s\n' "$ROLE" >&2; exit 2 ;;
esac
