#!/usr/bin/env bash
set -euo pipefail
REPO_DIR="${MISSION_REPO_DIR:-/Users/openclaw/Code/hermes-cli-cockpit}"
PORT="${MISSION_WEB_PORT:-4174}"
BIND="${MISSION_WEB_BIND:-0.0.0.0}"
ROOT="$REPO_DIR/web/openclaw"
if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "mission-web-openclaw: port $PORT is already listening; not replacing it." >&2
  lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >&2 || true
  exit 1
fi
exec python3 -m http.server "$PORT" --bind "$BIND" --directory "$ROOT"
